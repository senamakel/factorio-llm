#!/bin/sh
# One entrypoint, usable from any directory. Runtime state belongs to this checkout.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"
ACTION=${1:-help}
case "$ACTION" in
  setup)
    shift
    if [ ! -x .venv/bin/python ]; then python3 -m venv .venv; fi
    .venv/bin/python -m pip install -r requirements.txt
    exec .venv/bin/python scripts/factorio.py setup "$@"
    ;;
  help|--help|-h)
    cat <<'EOF'
Usage: ./factorio COMMAND [options]
  setup       Install Python dependencies, generate server config and install mod
  start       Start the local server; create a peaceful map if there is no save
  join        Open the game client with the server's mods and connect
  status      Query the live world
  stop        Save and gracefully stop this checkout's server
  register    Register all servers from mcp.json in Codex
  mcp         Start stdio MCP (for LLM clients)
  brain       Inspect, plan, stream, run, or review the local agent brain
  mcp-config  Print OpenHuman TOML; --format codex or json also supported
  client-mod  Install the mod into the desktop client's normal mods directory
  check       Run offline tests plus read-only live MCP check; --edits tests mutations
  reload-check Verify saved demo entity references in an isolated server
  episode     Score this checkout's brain on a disposable seeded world (--seed, --wall-secs)
  memory      Shared hive memory in CortexDB: remember / recall / list
  gates       Run the RSI loop's gates here: honesty check + offline brain tests
Options for setup: --binary PATH --read-data PATH --port N --game-port N
EOF
    ;;
  *)
    PY=.venv/bin/python
    if [ ! -x "$PY" ]; then
      # Worktrees (including tinyrsi candidates) share the primary checkout's venv.
      COMMON=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
      PY="${COMMON%/.git}/.venv/bin/python"
    fi
    if [ ! -x "$PY" ]; then
      echo 'Run ./factorio setup first' >&2
      exit 1
    fi
    shift
    case "$ACTION" in
      mcp) exec "$PY" scripts/mcp_entrypoint.py "$@" ;;
      brain) exec "$PY" -m brain "$@" ;;
      check)
        "$PY" -m unittest scripts.test_mcp_tools scripts.test_factorio_setup scripts.test_brain scripts.test_brain_actions scripts.test_brain_observation scripts.test_actions scripts.test_goal_score scripts.test_mcp_config scripts.test_research scripts.test_navigation scripts.test_blueprint scripts.test_timeouts scripts.test_tree_search scripts.test_fetch_wiki scripts.test_actuator scripts.test_harness
        "$PY" -m scripts.test_rcon
        "$PY" -m scripts.test_rcon_adversarial
        "$PY" scripts/check_readme_toml.py
        exec "$PY" scripts/smoke_mcp.py "$@"
        ;;
      reload-check) exec "$PY" scripts/verify_reload.py "$@" ;;
      episode) exec "$PY" -m harness.episode "$@" ;;
      gates) exec "$PY" -m harness.gates "$@" ;;
      memory) exec "$PY" scripts/memory.py "$@" ;;
      *) exec "$PY" scripts/factorio.py "$ACTION" "$@" ;;
    esac
    ;;
esac
